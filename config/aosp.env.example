# DreamByte OS M AOSP configuration
# Copy to config/aosp.env locally; do not commit secrets or machine-specific paths.

AOSP_MANIFEST_URL=https://android.googlesource.com/platform/manifest
AOSP_BRANCH=android15-release
AOSP_REVISION=255c6e39821c035f3213874f9bd980ce1b7056ad
AOSP_DIR=${HOME}/src/aosp-android15
AOSP_BUILD_TARGET=aosp_x86_64-userdebug
AOSP_JOBS=4

# The sync script refuses to download until this is explicitly set to 1.
AOSP_ALLOW_SYNC=0

# Optional: use an existing checkout instead of AOSP_DIR.
# AOSP_EXISTING_CHECKOUT=
